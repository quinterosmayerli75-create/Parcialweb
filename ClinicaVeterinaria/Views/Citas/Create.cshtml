@model ClinicaVeterinaria.Models.Cita

@{
    ViewData["Title"] = "Agendar Cita";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-calendar-plus me-2"></i>Agendar Nueva Cita
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Fecha" class="form-label fw-bold"></label>
                            <input asp-for="Fecha" class="form-control" type="datetime-local" />
                            <span asp-validation-for="Fecha" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MascotaId" class="form-label fw-bold">Mascota</label>
                            <select asp-for="MascotaId" class="form-select" asp-items="ViewBag.MascotaId">
                                <option value="">-- Selecciona tu Mascota --</option>
                            </select>
                            <span asp-validation-for="MascotaId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ServicioVeterinarioId" class="form-label fw-bold">Servicio Requerido</label>
                            <select asp-for="ServicioVeterinarioId" class="form-select" asp-items="ViewBag.ServicioVeterinarioId">
                                <option value="">-- Selecciona un Servicio --</option>
                            </select>
                            <span asp-validation-for="ServicioVeterinarioId" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-3">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Volver al listado
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i> Confirmar Cita
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}