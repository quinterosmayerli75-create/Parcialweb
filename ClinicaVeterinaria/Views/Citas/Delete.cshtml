@model ClinicaVeterinaria.Models.Cita

@{
    ViewData["Title"] = "Cancelar / Eliminar Cita";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3 border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>Confirmar Eliminación de Cita
                    </h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted mb-4">¿Está seguro de que desea cancelar / eliminar la siguiente cita de la base de datos?</p>

                    <div class="bg-light p-3 rounded mb-4 border">
                        <div class="row mb-2">
                            <div class="col-sm-5 fw-bold text-secondary">Fecha y Hora:</div>
                            <div class="col-sm-7 fw-semibold">@Model.Fecha.ToString("g")</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-5 fw-bold text-secondary">Estado:</div>
                            <div class="col-sm-7">
                                <span class="badge bg-secondary">@Model.Estado</span>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-5 fw-bold text-secondary">Mascota:</div>
                            <div class="col-sm-7">@(Model.Mascota?.Nombre ?? "No asignado")</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-5 fw-bold text-secondary">Servicio:</div>
                            <div class="col-sm-7">@(Model.ServicioVeterinario?.Nombre ?? "No asignado")</div>
                        </div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Cancelar y Volver
                            </a>
                            <button type="submit" class="btn btn-danger px-4 fw-bold">
                                <i class="bi bi-trash me-1"></i> Eliminar Definitivamente
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>