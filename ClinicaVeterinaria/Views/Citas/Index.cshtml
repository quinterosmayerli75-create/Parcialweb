@model IEnumerable<ClinicaVeterinaria.Models.Cita>

@{
    ViewData["Title"] = "Gestión de Citas";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 text-primary fw-bold mb-1">
                <i class="bi bi-calendar-event me-2"></i>Gestión de Citas
            </h1>
            <p class="text-muted mb-0">Administra y agende las citas médicas veterinarias.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Reportes" asp-action="AgendaCitasPDF" class="btn btn-outline-danger d-flex align-items-center gap-2" target="_blank">
                <i class="bi bi-file-earmark-pdf-fill"></i> Agenda PDF
            </a>
            <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i> Nueva Cita
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@Html.DisplayNameFor(model => model.Fecha)</th>
                            <th>Mascota</th>
                            <th>Servicio</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                    No hay citas registradas en el sistema.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-medium text-dark">
                                        <i class="bi bi-clock me-1 text-muted"></i>
                                        @item.Fecha.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        <span class="fw-bold text-secondary">
                                            @(item.Mascota?.Nombre ?? "Sin asignar")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(item.ServicioVeterinario?.Nombre ?? "Sin asignar")
                                        </span>
                                    </td>
                                    <td>
                                        @switch (item.Estado)
                                        {
                                            case "Pendiente":
                                                <span class="badge bg-warning text-dark">Pendiente</span>
                                                break;
                                            case "Confirmada":
                                                <span class="badge bg-info text-white">Confirmada</span>
                                                break;
                                            case "Completada":
                                                <span class="badge bg-success">Completada</span>
                                                break;
                                            case "Cancelada":
                                                <span class="badge bg-danger">Cancelada</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@item.Estado</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-controller="Reportes" asp-action="ComprobanteCitaPDF" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Descargar Ticket PDF" target="_blank">
                                                <i class="bi bi-file-pdf"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>