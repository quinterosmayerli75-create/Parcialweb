@model ClinicaVeterinaria.Models.Mascota

@{
    ViewData["Title"] = "Detalles de Mascota";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="m-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Información de la Mascota</h4>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-bold">Nombre:</div>
                        <div class="col-sm-8 fs-5 fw-bold text-dark">@Model.Nombre</div>
                    </div>
                    <hr />
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-bold">Especie:</div>
                        <div class="col-sm-8"><span class="badge bg-info text-dark">@Model.Especie</span></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-bold">Raza:</div>
                        <div class="col-sm-8">@(string.IsNullOrEmpty(Model.Raza) ? "No especificada" : Model.Raza)</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-bold">Edad:</div>
                        <div class="col-sm-8">@Model.Edad años</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-bold">Peso:</div>
                        <div class="col-sm-8">@Model.Peso kg</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-bold">Propietario:</div>
                        <div class="col-sm-8 fw-semibold">@(Model.Usuario?.UserName ?? "Sin asignar")</div>
                    </div>

                    <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white me-2"><i class="bi bi-pencil me-1"></i>Editar</a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Eliminar</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>