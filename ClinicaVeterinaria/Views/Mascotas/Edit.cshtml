@model ClinicaVeterinaria.Models.Mascota

@{
    ViewData["Title"] = "Editar Mascota";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h3 class="fw-bold text-primary mb-4">
                    <i class="bi bi-pencil-square me-2"></i>Editar Mascota
                </h3>

                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="UsuarioId" />

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Especie" class="form-label fw-semibold"></label>
                            <input asp-for="Especie" class="form-control" placeholder="Ej. Perro, Gato" />
                            <span asp-validation-for="Especie" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Raza" class="form-label fw-semibold"></label>
                            <input asp-for="Raza" class="form-control" />
                            <span asp-validation-for="Raza" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="Edad" class="form-label fw-semibold"></label>
                            <input asp-for="Edad" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Edad" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Peso" class="form-label fw-semibold"></label>
                            <input asp-for="Peso" class="form-control" type="number" step="any" min="0" />
                            <span asp-validation-for="Peso" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Volver
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}