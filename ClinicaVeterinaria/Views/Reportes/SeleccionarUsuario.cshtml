@{
    ViewData["Title"] = "Seleccionar Cliente";
}

<div class="container py-4">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 500px;">
        <div class="card-header bg-primary text-white">
            <h5 class="card-title mb-0">
                <i class="bi bi-person-bounding-box me-2"></i>Reporte de Citas por Cliente
            </h5>
        </div>
        <div class="card-body p-4">
            <p class="text-muted small">Seleccione un cliente para generar su reporte detallado en PDF.</p>

            <form asp-controller="Reportes" asp-action="CitasPorUsuarioPDF" method="get" target="_blank">
                <div class="mb-3">
                    <label class="form-label fw-bold">Cliente / Usuario:</label>
                    <select name="usuarioId" class="form-select" asp-items="ViewBag.Usuarios" required>
                        <option value="">-- Seleccione un usuario --</option>
                    </select>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-file-earmark-pdf me-1"></i> Generar PDF
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>