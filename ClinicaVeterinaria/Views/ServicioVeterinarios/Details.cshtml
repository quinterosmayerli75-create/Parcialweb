@model ClinicaVeterinaria.Models.ServicioVeterinario

@{
    ViewData["Title"] = "Detalles del Servicio";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-info text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-info-circle me-2"></i>Detalles del Servicio
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label class="text-muted fw-bold d-block small mb-1">Nombre del Servicio</label>
                        <p class="fs-5 fw-bold text-dark mb-0">@Model.Nombre</p>
                    </div>

                    <div class="mb-4">
                        <label class="text-muted fw-bold d-block small mb-1">Descripción</label>
                        <p class="fs-6 text-secondary bg-light p-3 rounded border">
                            @(string.IsNullOrEmpty(Model.Descripcion) ? "Sin descripción disponible." : Model.Descripcion)
                        </p>
                    </div>

                    <div class="mb-4">
                        <label class="text-muted fw-bold d-block small mb-1">Precio Unitario</label>
                        <p class="fs-4 fw-bold text-success mb-0">
                            $@Model.Precio.ToString("F2")
                        </p>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Volver al catálogo
                        </a>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning fw-bold">
                                <i class="bi bi-pencil me-1"></i> Editar Servicio
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>