@model IEnumerable<ClinicaVeterinaria.Models.ServicioVeterinario>

@{
    ViewData["Title"] = "Catálogo de Servicios";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 text-primary fw-bold mb-1">
                <i class="bi bi-journal-medical me-2"></i>Catálogo de Servicios
            </h1>
            <p class="text-muted mb-0">Gestión de servicios médicos y tarifas veterinarias.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Reportes" asp-action="ServiciosPDF" class="btn btn-outline-danger d-flex align-items-center gap-2" target="_blank">
                <i class="bi bi-file-earmark-pdf-fill"></i> Catálogo PDF
            </a>
            <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i> Nuevo Servicio
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Servicio</th>
                            <th>Descripción</th>
                            <th>Precio</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                    No hay servicios registrados en el catálogo.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">
                                        @Html.DisplayFor(modelItem => item.Nombre)
                                    </td>
                                    <td class="text-muted">
                                        @Html.DisplayFor(modelItem => item.Descripcion)
                                    </td>
                                    <td>
                                        <span class="badge bg-success fs-6 fw-normal">
                                            @item.Precio.ToString("C")
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>